<?xml version="1.0"?>
<workflow id="151" url="https://staging-formulaires.guichet-citoyen.be/backoffice/workflows/151/">
  <name>Signaler un probl&#232;me sur le site</name>
  <slug>signaler-un-probleme-sur-le-site</slug>
  <roles>
    <role id="_receiver">Agent traitant</role>
  </roles>
  <possible_status>
    <status>
      <id>just_submitted</id>
      <name>Nouvelle demande</name>
      <colour>#FFFFFF</colour>
      <visibility>
        <role>__restricted__</role>
      </visibility>
      <items>
        <item type="displaymsg" id="1">
          <to>
            <item role_id="_submitter">_submitter</item>
          </to>
          <message>Merci pour votre signalement. 
Notre administration reviendra vers vous pour effectuer le suivi requis.</message>
          <level>info</level>
          <position>top</position>
        </item>
        <item type="dispatch" id="2">
          <role_key>_receiver</role_key>
          <operation_mode>set</operation_mode>
          <dispatch_type>manual</dispatch_type>
          <role_id slug="{{ form_var_type_role }}" role_id="{{ form_var_type_role }}">{{ form_var_type_role }}</role_id>
        </item>
        <item type="sendmail" id="3">
          <to>
            <item role_id="{{ form_var_type_mail }}">{{ form_var_type_mail }}</item>
          </to>
          <subject>Nouveau signalement ({{ form_name }})</subject>
          <body>Bonjour,

Un citoyen a signal&#233; un probl&#232;me concernant le site web. 
En cause : {{ form_var_type }}

Vous pouvez :

- `Consulter la demande via l'e-guichet &lt;{{ form_url_backoffice }}&gt;`_

- Voir le d&#233;tail de la demande ci-dessous :

{{ form_details }}

Cordialement
</body>
        </item>
        <item type="sendmail" id="4">
          <to>
            <item role_id="{{ form_var_email }}">{{ form_var_email }}</item>
          </to>
          <subject>Votre demande {{ form_name }}</subject>
          <body>Bonjour,

Nous vous confirmons la r&#233;ception de votre signalement &#224; notre administration communale.
{% if form_user %}
Vous pouvez la consulter en suivant ce lien&#160;: {{ form_url }}
{% endif %}
Voici votre code de suivi : {{ form_tracking_code }} .
{% if form_details %}
Pour r&#233;f&#233;rence, voici le d&#233;tail de la demande&#160;:

{{ form_details }}
{% endif %}
</body>
        </item>
        <item type="jump" id="5">
          <status>accepted</status>
          <mode>immediate</mode>
          <set_marker_on_status>False</set_marker_on_status>
        </item>
      </items>
    </status>
    <status>
      <id>accepted</id>
      <name>En cours de traitement</name>
      <colour>#66CCFF</colour>
      <visibility />
      <items>
        <item type="form" id="3">
          <by>
            <item role_id="_receiver">_receiver</item>
          </by>
          <varname>commentaire</varname>
          <hide_submit_button>True</hide_submit_button>
          <include_in_form_history>True</include_in_form_history>
          <formdef>
            <name>-</name>
            <fields>
              <field>
                <type>text</type>
                <label type="str">Commentaire</label>
                <required type="str">required</required>
                <varname type="str">commentaire</varname>
                <display_locations />
                <display_mode type="str">pre</display_mode>
                <id type="str">43a24584-b6c0-44e6-b0f6-d814ec4df3ed</id>
              </field>
            </fields>
          </formdef>
        </item>
        <item type="choice" id="4">
          <label>Envoyer le commentaire</label>
          <by>
            <item role_id="_receiver">_receiver</item>
          </by>
          <status>0</status>
          <require_confirmation>False</require_confirmation>
          <backoffice_info_text>&lt;p&gt;R&amp;eacute;pondez au citoyen dans cette zone de texte. Votre r&amp;eacute;ponse apparaitra dans le suivi de sa demande.&lt;/p&gt;
</backoffice_info_text>
          <ignore_form_errors>False</ignore_form_errors>
          <set_marker_on_status>False</set_marker_on_status>
          <allow_as_mass_action>False</allow_as_mass_action>
        </item>
      </items>
    </status>
    <status>
      <id>finished</id>
      <name>Termin&#233;</name>
      <colour>#CCCCCC</colour>
      <forced_endpoint>true</forced_endpoint>
      <visibility />
      <items>
        <item type="register-comment" id="1">
          <to>
            <item role_id="_receiver">_receiver</item>
          </to>
          <comment>{{ form_workflow_form_contact_var_suite }}</comment>
        </item>
      </items>
    </status>
    <status>
      <id>0</id>
      <name>Trait&#233;</name>
      <colour>#FFFFFF</colour>
      <visibility />
      <items>
        <item type="form" id="3">
          <by>
            <item role_id="_receiver">_receiver</item>
          </by>
          <varname>contact</varname>
          <hide_submit_button>True</hide_submit_button>
          <include_in_form_history>False</include_in_form_history>
          <formdef>
            <name>-</name>
            <fields>
              <field>
                <type>text</type>
                <label type="str">Suite donn&#233;e au signalement (en interne)</label>
                <required type="str">required</required>
                <hint type="str">Indiquez ici quelle suite vous avez donn&#233; au signalement du citoyen (par t&#233;l&#233;phone, par mail, via le guichet) et toute autre information utile pour vos coll&#232;gues. Le citoyen ne verra pas ce qui est not&#233;.</hint>
                <varname type="str">suite</varname>
                <display_locations />
                <prefill>
                  <type>none</type>
                </prefill>
                <anonymise type="str">final</anonymise>
                <display_mode type="str">plain</display_mode>
                <id type="str">1</id>
              </field>
            </fields>
          </formdef>
        </item>
        <item type="choice" id="1">
          <label>Cloturer la demande</label>
          <by>
            <item role_id="_receiver">_receiver</item>
          </by>
          <status>finished</status>
          <require_confirmation>True</require_confirmation>
          <backoffice_info_text>&lt;p&gt;Cliquer sur ce bouton permet de cloturer d&amp;eacute;finitivement la demande.&lt;/p&gt;
</backoffice_info_text>
          <ignore_form_errors>False</ignore_form_errors>
          <set_marker_on_status>False</set_marker_on_status>
          <allow_as_mass_action>True</allow_as_mass_action>
        </item>
      </items>
    </status>
  </possible_status>
</workflow>